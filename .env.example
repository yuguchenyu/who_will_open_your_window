# Copy to .env, fill locally, then restart the service. Do not share .env.
# API_BASE is the directory immediately BEFORE /chat/completions.
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=your-model-name
AI_API_KEY=your-api-key
PORT=3210

# 默认 AI_BASE_URL 只允许 HTTPS 或本机回环地址（127.0.0.1/localhost），防止 API key
# 被明文发去不可信地址。如果你的模型代理是局域网内的明文 HTTP（如校园网里的
# 网关服务），在这里显式写 1 豁免 —— 只在你自己的受信网络里这么做。
ALLOW_HTTP_AI=0

# 账号与互动数据的 SQLite 文件。留空则用 runtime/app.db（该目录已在 .gitignore 中）。
# 这个文件里存着所有人的账号和聊天记录，不要提交、不要外发。
DB_PATH=

# 默认只监听 127.0.0.1。设为 1 才允许同一局域网的其他设备访问（监听 0.0.0.0，
# 并把本机网卡地址加入 Host/Origin 白名单）。/api/* 需要登录，但会话令牌在局域网内
# 是明文传输的（见 README「已知限制」），只在你信任的网络里开。
ALLOW_LAN=0

# 只允许指定设备访问，逗号分隔。填写后自动开启局域网监听（无需再设 ALLOW_LAN=1）；
# 注意这会【覆盖】上面的 ALLOW_LAN=0——白名单必须先监听局域网才能生效，
# 启动日志会写明"ALLOW_LAN=0 已被忽略"，不会静默失效。
# 校验的是 TCP 对端真实地址，不信任 X-Forwarded-For；本机 127.0.0.1 始终放行。
# 只推荐填固定 IP 的设备；手机等 DHCP 地址会变，变了就连不上。
# 例：ALLOW_IPS=10.22.37.9,10.22.37.14
ALLOW_IPS=
